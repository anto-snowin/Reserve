{
  "name": "reserveproof",
  "version": "1.0.0",
  "private": true,
  "description": "Privacy-preserving proof-of-reserves and solvency verification platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm --workspace=@reserveproof/web run dev",
    "build": "npm run zk:compile && npm --workspace=@reserveproof/shared run build && npm --workspace=@reserveproof/contracts run compile && npm --workspace=@reserveproof/web run build",
    "lint": "npm --workspace=@reserveproof/web run lint",
    "typecheck": "npm --workspace=@reserveproof/shared run typecheck && npm --workspace=@reserveproof/web run typecheck",
    "test": "node scripts/run-all-tests.js",
    "zk:compile": "npm --workspace=@reserveproof/zk run compile",
    "zk:setup:dev": "npm --workspace=@reserveproof/zk run setup:dev",
    "zk:prove": "npm --workspace=@reserveproof/zk run prove",
    "zk:verify": "npm --workspace=@reserveproof/zk run verify",
    "contracts:compile": "npm --workspace=@reserveproof/contracts run compile",
    "contracts:test": "npm --workspace=@reserveproof/contracts run test",
    "chain:local": "npx hardhat node",
    "deploy:local": "npm --workspace=@reserveproof/contracts run deploy:local",
    "deploy:sepolia": "npm --workspace=@reserveproof/contracts run deploy:sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "hardhat": "^3.16.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2"
  }
}
